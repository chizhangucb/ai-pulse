# AI Pulse configuration. Copy to .env and edit (or run node scripts/init-env.ts, which writes .env with random secrets).
# The web app only gets the site address; every secret stays in the backend. Never commit .env.

# ===== Required =====

# The site's public address: links, RSS, share images and MCP all use it. Keep this one to try the site locally.
SITE_URL=http://localhost:3000

# Admin password (at least 12 characters), for signing in at /admin.
ADMIN_PASSWORD=

# Secrets that sign sessions and image proxy URLs: a random string each (openssl rand -hex 32 makes one).
SESSION_SECRET=
IMG_PROXY_SIGN_SECRET=

# Database password with Docker (the database opens no outside port; still use a random string).
POSTGRES_PASSWORD=

# Model: any OpenAI-compatible API works, and every step uses it by default. The default is OpenRouter with
# Claude Haiku 5.5 (cheap, fast, reads images). Get a key at https://openrouter.ai/keys.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=anthropic/claude-haiku-5.5
# Provider-specific request fields (JSON), merged into every request body. Claude Haiku 5.5 on OpenRouter reasons
# by default, and the reasoning shares each step's output budget (up to 1,112 of 1,200 tokens in a measured run, so
# some structure and grouping calls hit the limit). Turning reasoning off keeps the whole budget for the answer.
# Remove this line or replace it for a model that should reason; OpenRouter routing goes here too, for example
# {"reasoning":{"enabled":false},"provider":{"sort":"price"}}.
LLM_EXTRA_JSON={"reasoning":{"enabled":false}}
# Turn on when the model reads images (titles and summaries of picks then look at the first image):
LLM_VISION=true
# JSON mode (response_format) is on by default. Every OpenRouter endpoint of anthropic/claude-haiku-5.5 lists
# response_format, so keep it on; set false only for a model whose endpoints do not:
# LLM_JSON_MODE=false
# Extra output tokens for reasoning models (reasoning and answer share the output budget), added to every step's
# own budget; 0 when unset. Set it when calls fail with "output token limit reached (finish_reason=length)":
# LLM_REASONING_TOKENS=4000

# ===== Optional: more accurate story grouping =====

# Vector recall: any OpenAI-compatible /embeddings endpoint. The site runs without it, finding grouping candidates by
# shared wording, but most discussion posts that only count as heat (hot_signal sources) then attach to no story, so
# trending scores run low.
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# Or set only an Alibaba Cloud DashScope key to use text-embedding-v4:
# DASHSCOPE_API_KEY=
# Vector dimensions (with EMBEDDING_* the service's own by default, DashScope 1024); changing it recomputes old vectors:
# EMBEDDING_DIMS=

# ===== Optional: a different model per step =====
# Every step uses LLM_* above by default. To give one step another model, set a preset name from site/models.ts:
#   PREFILTER_MODEL  SCORE_MODEL  UNDERSTAND_MODEL  SUMMARIZE_MODEL  WORDING_MODEL  STRUCTURE_MODEL
#   GROUP_MODEL  GROUP_REVIEW_MODEL  DIGEST_MODEL  REPORT_MODEL  TRANSLATE_MODEL
# OpenRouter presets (use the LLM_BASE_URL / LLM_API_KEY above, no extra key):
#   or-claude-haiku  or-claude-sonnet  or-gpt-luna  or-gemini-flash-lite
# For example: SCORE_MODEL=or-gpt-luna
# An unknown name stops the api and worker at startup. LLM_EXTRA_JSON applies only to the default model; a preset
# sends its own fields. Claude Sonnet 5.5 writes the headline, summary and why it matters; the other steps stay on
# the default Haiku:
UNDERSTAND_MODEL=or-claude-sonnet
# Direct provider presets and their keys:
#   deepseek-flash / deepseek-flash-think        DEEPSEEK_BASE_URL=https://api.deepseek.com/v1  DEEPSEEK_API_KEY=
#   qwen3.7-flash / qwen3.8-flash / qwen3-vl-flash  DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  DASHSCOPE_API_KEY=
#   glm-5.3-flash / glm-5.3-flash-selection     ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4  ZHIPU_API_KEY=
#   mimo-v2.6-flash                             XIAOMI_MIMO_BASE_URL=https://api.xiaomimimo.com/v1  XIAOMI_MIMO_API_KEY=
# Note: with DASHSCOPE_API_KEY set and no EMBEDDING_API_KEY, grouping uses DashScope embeddings (billed by them).

# ===== Optional: paid collection services (billed per request, with budget circuit breakers under admin Settings) =====
# X (Twitter) accounts: SocialData
# SOCIALDATA_API_KEY=
# WeChat official accounts: Dajiala
# DAJIALA_KEY=
# Browser rendering when a page body cannot be fetched: Jina Reader
# JINA_API_KEY=

# ===== Optional: Feishu =====
# Push picks to a Feishu group (only picks from T1 and T1_5 sources): enable the target under admin Settings →
# Notification targets and put its webhook address here.
FEISHU_CONTENT_PUSH_ENABLED=false
# FEISHU_PUSH_WEBHOOK_URL=
# FEISHU_PUSH_MIRROR_WEBHOOK_URL=
# Alerts and feedback forwarded to an internal Feishu group (needs a custom Feishu app):
FEISHU_INTERNAL_ENABLED=false
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_INTERNAL_CHAT_ID=
# FEISHU_ALERT_CHAT_ID=
# Sign in to the admin with a Feishu account (optional, alongside the admin password):
# FEISHU_LOGIN_APP_ID=
# FEISHU_LOGIN_APP_SECRET=
# ADMIN_FEISHU_UNION_IDS=
# ADMIN_EMAILS=

# ===== Optional: other =====
# Sent by JSON sources that read api.github.com, for a higher rate limit. A free, read-only GitHub token is enough:
# GITHUB_TOKEN=
# Token for external scripts pushing items (POST /api/ingest/items), at least 16 characters; unset disables the
# endpoint. AI Pulse's hourly X job uses it (docs/ingest-x.md):
# INGEST_TOKEN=
# Pushes per client and minute on the ingest endpoint (10 by default with docker compose); 0 when a reverse proxy in
# front already limits them:
# INGEST_RATE_LIMIT=10
# When fetching sources must go through a proxy:
# EGRESS_PROXY_URL=http://127.0.0.1:7890
# When a source's feed or listing is a service on your private network (say RSSHub in the same Docker network), list its
# full host names, comma separated (case-insensitive, no wildcards). Only those addresses are allowed, directly and not
# through the proxy above; redirects to other hosts, article bodies and images still cannot reach the private network,
# and link-local and cloud metadata addresses are always refused:
# PRIVATE_FEED_HOSTS=rsshub
# Traffic limits for the image proxy fetching from original sites (MB per minute, GB per day); past them, uncached images
# return 503. Unset, DEPLOYMENT.imageUpstreamBudget in site/site.ts applies, which has no limit by default:
# IMGPROXY_UPSTREAM_MB_PER_MINUTE=300
# IMGPROXY_UPSTREAM_GB_PER_DAY=30
# true behind a reverse proxy such as Caddy or Nginx, so visitor addresses come from its X-Forwarded-For. Keep false
# when the site faces the internet directly, so nobody can fake an address to get around sign-in and feedback limits.
TRUST_PROXY=false
# MCP accepts only requests to the SITE_URL host (and localhost); list any other host names here, comma separated:
# MCP_ALLOWED_HOSTS=
# Minutes without new content before the site counts as "stopped collecting" and alerts; unset, ALERTS.quietMinutes in
# site/site.ts (360 by default):
# ALERT_QUIET_MINUTES=360
# Submit new pages to IndexNow (Bing and others) daily; the key is 32 hex characters you generate:
INDEXNOW_SUBMIT_ENABLED=false
# INDEXNOW_KEY=
# Daily database backups to S3-compatible object storage (AWS S3, Tencent COS, Alibaba OSS...).
# Without DB_BACKUP_STORE_DOMAIN the address is built for Tencent COS (<bucket>.cos.<region>.myqcloud.com);
# for another provider give the host with the bucket, e.g. my-bucket.s3.us-east-1.amazonaws.com for AWS S3:
# DB_BACKUP_STORE_SECRET_ID=
# DB_BACKUP_STORE_SECRET_KEY=
# DB_BACKUP_STORE_BUCKET=
# DB_BACKUP_STORE_REGION=
# DB_BACKUP_STORE_DOMAIN=
# Log level (info by default) and database pool size (10 by default):
# LOG_LEVEL=info
# DATABASE_POOL_MAX=10
# Release name, shown on the admin Runs page and /api/health, to confirm the processes were replaced after an upgrade:
# AIHOT_RELEASE=
# Environment name, production or development from NODE_ENV by default; alerts outside production carry it, and the dev
# sign-in bypass works only outside production:
# AIHOT_ENVIRONMENT=
# Keep secrets in a directory by group (models.env, collectors.env, integrations.env, auth.env) instead of here; values
# set here win:
# AIHOT_CREDENTIALS_DIR=

# ===== Safety valves =====
# Sources are fetched (daily source icons included) and models called only when these are true; delete the two lines or
# set false to stop both (handy while working on the UI). Every *_ENABLED switch in this file accepts only true; 1, yes
# or TRUE count as off.
COLLECT_ENABLED=true
MODEL_CALLS_ENABLED=true

# ===== Only when running on this machine without Docker =====
# DATABASE_URL=postgres://username@127.0.0.1:5432/myhot
# API_BASE_URL=http://127.0.0.1:3001
# Directory for uploads, the image cache and local backups (.data in the repository by default):
# AIHOT_DATA_DIR=/var/lib/myhot
# Enter the admin without signing in while developing (production refuses to start with it), and the name it shows:
# DEV_AUTH_ROLE=admin
# DEV_AUTH_DISPLAY_NAME=Dev Admin
# Allow fetching private network addresses while debugging locally (off by default; production refuses to start):
# ALLOW_PRIVATE_NETWORK_FETCH=true

# ===== With docker compose --profile https =====
# SITE_DOMAIN=example.com
# The port the site opens on this machine (docker compose, 3000 on every interface by default); with HTTPS only the local
# Caddy uses it, not the outside:
# PORT=127.0.0.1:3000
# Also set TRUST_PROXY above to true.
